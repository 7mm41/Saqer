# Katf reverse proxy: automatic HTTPS, security headers, routing.
#   /api/*            → api
#   /<ADMIN_PATH>/*   → api (admin panel; any other admin-looking URL is a plain 404)
#   /tech/*           → technician PWA (static files in this image)
#   everything else   → web (customer website)
{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	log {
		# no query strings in logs: signed links and tracking tokens live there
		format filter {
			wrap json
			fields {
				request>uri query {
					delete t
					delete sig
					delete exp
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 32
				}
			}
		}
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:4000
	}

	@admin path /{$ADMIN_PATH} /{$ADMIN_PATH}/*
	handle @admin {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api:4000
	}

	@tech path /tech /tech/*
	handle @tech {
		root * /srv
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header X-Robots-Tag "noindex"
		@hashed path /tech/assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell path /tech/sw.js /tech/index.html /tech/manifest.webmanifest
		header @shell Cache-Control "no-cache"
		try_files {path} /tech/index.html
		file_server
	}

	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$MAP_TILE_HOSTS}; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' {$PAYMENT_HOSTS}; object-src 'none'"
		reverse_proxy web:3000
	}
}

# www → apex
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
