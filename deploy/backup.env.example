# Backup settings (restic: AES-256 encrypted, deduplicated). Kept apart from .env so the app containers
# never see backup credentials. install.sh copies this to deploy/backup.env and generates RESTIC_PASSWORD.
# Keep an offline copy of RESTIC_PASSWORD: without it the backups cannot be opened.

# Local folder by default. Strongly recommended: an off-site repository, e.g.
#   s3:s3.amazonaws.com/bucket/katf   b2:bucket:katf   sftp:user@host:/backups/katf
RESTIC_REPOSITORY=/var/backups/katf
RESTIC_PASSWORD=
# how many daily backups to keep
KEEP_DAILY=14
# credentials for S3 / B2 repositories (leave empty for a local folder)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
