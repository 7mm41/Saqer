# Katf production settings.
# install.sh copies this to deploy/.env and fills every secret with random values.
# Never commit deploy/.env. Keep an offline copy of it (password manager): without DATA_KEY the encrypted
# personal data in a backup cannot be read, and without RESTIC_PASSWORD the backup cannot be opened.

# ---------------------------------------------------------------- site
DOMAIN=katf.example.om
ACME_EMAIL=owner@example.om

# ---------------------------------------------------------------- secrets (generated by install.sh)
POSTGRES_PASSWORD=
# 32 random bytes, hex. Encrypts personal data fields. Rotating it: see docs/runbooks.md.
DATA_KEY=
DATA_KEY_PREVIOUS=
# Secret admin URL path (24+ letters/digits). Rotate with rotate-admin-path.sh.
ADMIN_PATH=

# ---------------------------------------------------------------- payments (mock until the legal gate is cleared)
PAYMENT_PROVIDER=mock
THAWANI_BASE_URL=https://uatcheckout.thawani.om
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
# true only after the owner signs the live merchant contract and legal_gate_cleared is on
THAWANI_LIVE=false

# ---------------------------------------------------------------- SMS (console = codes go to the API log only)
SMS_PROVIDER=console
SMS_SENDER=Katf
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# ---------------------------------------------------------------- push notifications
# Web push keys are generated by install.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.om
# iPhone app (APNs): fill after creating the key in the Apple developer account (docs/ios.md)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=om.katf.pro
APNS_KEY_P8_BASE64=
APNS_PRODUCTION=false

# ---------------------------------------------------------------- email (optional)
SMTP_URL=
MAIL_FROM=Katf <no-reply@example.om>

# ---------------------------------------------------------------- content security policy extras
MAP_TILE_HOSTS=https://tile.openstreetmap.org
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PAYMENT_HOSTS=https://uatcheckout.thawani.om https://checkout.thawani.om

# ---------------------------------------------------------------- never on in production unless you mean it
# Labelled demo data (a demo technician). Off by default.
DEMO_MODE=false
LOG_LEVEL=info
