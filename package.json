{
  "name": "katf",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . && node scripts/check-rtl.mjs && node scripts/check-money.mjs",
    "dev:api": "pnpm --filter @katf/api dev",
    "dev:web": "pnpm --filter @katf/web dev",
    "dev:tech": "pnpm --filter @katf/tech dev",
    "dev:admin": "pnpm --filter @katf/admin dev",
    "e2e": "pnpm --filter @katf/e2e test",
    "ios:sync": "pnpm --filter @katf/tech ios:sync",
    "demo:record": "pnpm --filter @katf/api demo:record"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
