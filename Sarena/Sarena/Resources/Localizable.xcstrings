    "%@ / year · every venue, all year" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سنوياً · كل الأماكن طوال السنة"
          }
        }
      }
    },
    "%@ for one more year. It starts when your current membership ends, so you keep every remaining day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ لسنة إضافية، تبدأ عند انتهاء عضويتك الحالية فلا تخسر أي يوم متبقٍّ."
          }
        }
      }
