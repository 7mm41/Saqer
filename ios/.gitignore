# Xcode output and per-user state. Everything else in ios/ is committed so the project builds
# straight after cloning; ios/Katf/public, ios/Plugins and CapApp-SPM/Package.swift are regenerated by
# `pnpm ios:sync` (CI checks they are current).
build/
DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/
CapApp-SPM/.build/
