<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App privacy manifest. Katf does no tracking and has no third-party analytics or ad SDKs.
  Data listed here is collected only to run the service (App Functionality) and is linked to the technician's account.
-->
