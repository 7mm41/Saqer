# Development needs no .env: the API uses an embedded database, prints sign-in codes to its log and
# uses a test payment page. Optional overrides for local work:
#   PORT=4000
#   DEMO_MODE=true            # labelled demo technician (after: pnpm --filter @katf/api cli demo-seed)
#   ADMIN_PATH=dev-admin
#   PUBLIC_ORIGIN=http://localhost:3000
#   TECH_ORIGIN=http://localhost:5173
#
# Production settings and secrets: see deploy/.env.example (created on the server by deploy/install.sh).
