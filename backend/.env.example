# Sarena API — copy to .env and adjust. Every value is optional in development.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# The address people use, e.g. https://sarena.om (optional; shown when the server starts).
# Uploaded images are stored as paths (/uploads/...), so they keep working if the address changes.
PUBLIC_URL=

# PostgreSQL. Leave empty to use the embedded database in DATA_DIR (development / small installs).
DATABASE_URL=
DATA_DIR=data
UPLOADS_DIR=data/uploads

# Required in production: at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=
TOKEN_TTL_DAYS=30

# First dashboard admin (created on first start). A password is generated and printed when empty.
# Forgot it? Stop the server and run: npm run admin-password
ADMIN_EMAIL=admin@sarena.om
ADMIN_PASSWORD=

# Demo member + fixed SMS code 123456 for +968 9123 4567. Defaults to on outside production.
DEMO_MODE=
# "demo" grants memberships without payment (testing). Production: "disabled" until StoreKit/web payments are wired.
PAYMENTS_MODE=

# SMS codes: "console" (logs them) or "twilio".
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Store and support links (website, app "Contact us").
APP_STORE_URL=
GOOGLE_PLAY_URL=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
INSTAGRAM_URL=

# Push notifications (Apple). Create a key at developer.apple.com › Keys (Apple Push Notifications service).
# Without these, notifications are recorded and logged but not delivered.
# Check them in the control panel: Notifications › "Send a test to my phone" shows Apple's answer.
# The 10-character Key ID shown next to the key, and your 10-character Team ID (developer.apple.com › Membership).
APNS_KEY_ID=
APNS_TEAM_ID=
# The app's Bundle Identifier. Phones on current app versions send their own, so this is a fallback.
APNS_BUNDLE_ID=om.sarena.app
# The AuthKey_XXXXXXXXXX.p8 file: a path relative to backend/ (e.g. certs/AuthKey_ABC123DEFG.p8), a full
# path, or ~/… Or paste the key itself into APNS_KEY.
APNS_KEY_FILE=
# Apple has two gateways: Xcode builds use the sandbox, TestFlight and App Store production. Current app
# versions tell the server which one they use; this is only for phones registered by older versions.
APNS_PRODUCTION=

# Apple Wallet passes (membership card + booking codes, each with a QR the venue scans in "Redeem codes").
# developer.apple.com › Identifiers › Pass Type IDs: create e.g. pass.om.sarena.membership, then its
# certificate. Open it in Keychain Access, export certificate + private key as .p12. Download Apple's
# "Worldwide Developer Relations - G4" certificate. Paths are relative to backend/. Off until all are set.
WALLET_PASS_TYPE_ID=
WALLET_TEAM_ID=
WALLET_CERT_FILE=
WALLET_CERT_PASSWORD=
WALLET_WWDR_FILE=
WALLET_ORGANIZATION=Sarena

# Automatic notifications & seasonal themes run on a 30-second scheduler.
SCHEDULER=true
# Oman is UTC+4.
TIMEZONE_OFFSET_MINUTES=240

# Where the website and the built dashboard live (served at / and /admin/).
WEBSITE_DIR=../website
DASHBOARD_DIR=../dashboard/dist
